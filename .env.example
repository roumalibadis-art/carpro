# Environment variables (ASP.NET Core maps "__" to ":"). Never commit a real .env or real secrets.
ASPNETCORE_ENVIRONMENT=Production
Database__Provider=MySql
Database__ServerType=MySql          # or MariaDb
Database__ServerVersion=8.0.36
Database__AutoMigrate=true          # applies EF migrations at start-up (set false if you migrate in CI)
ConnectionStrings__Default=Server=localhost;Database=prospecta;User=prospecta;Password=CHANGE_ME;
Jwt__Secret=CHANGE_ME_32_CHARS_MINIMUM_RANDOM_VALUE
Bootstrap__AdminEmail=admin@your-company.dz     # used only while the user table is empty
Bootstrap__AdminPassword=CHANGE_ME_Str0ng!Pass
ForwardedHeaders__Enabled=true      # behind a reverse proxy so client IPs are logged correctly
