{
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
    "WriteTo": [ { "Name": "File", "Args": { "path": "logs/prospecta-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } } ]
  },
  "AllowedHosts": "*",
  "Database": { "Provider": "MySql", "ServerType": "MySql", "ServerVersion": "8.0.36", "AutoMigrate": false },
  "ConnectionStrings": { "Default": "" },
  "Jwt": { "Issuer": "prospecta", "Audience": "prospecta-api", "ExpiresMinutes": 60 },
  "Duplicates": { "SuspectThreshold": 0.55, "StrongThreshold": 0.9, "ProximityMeters": 75 },
  "Import": { "MaxFileBytes": 5242880, "MaxRows": 5000, "MaxColumns": 60 },
  "RateLimit": { "LoginPerMinute": 10 },
  "ForwardedHeaders": { "Enabled": false },
  "Swagger": { "Enabled": false },
  "Seed": { "DemoData": false }
}
