@page
@model Prospecta.Web.Pages.Reports.NewModel
@{ ViewData["Title"] = "Nouveau rapport"; bool needsPeriod = Model.Type is ReportType.Individual or ReportType.Manager; }
<h1>Nouveau rapport</h1>
<nav class="row">
    @foreach (var (t, label) in new[] { (ReportType.MarketStudy, "A · Étude de marché"), (ReportType.OutingBalance, "B · Bilan de sortie"), (ReportType.Individual, "C · Individuel"), (ReportType.Manager, "D · Responsable") })
    {
        @if (t == ReportType.Manager && !User.HasClaim(Permissions.ClaimType, Permissions.ReportViewTeam)) { continue; }
        <a class="btn @(Model.Type == t ? "" : "secondary")" href="/Reports/New?Type=@t">@label</a>
    }
</nav>
@if (!ModelState.IsValid) { <div class="alert err" role="alert"><ul>@foreach (var e in ModelState.Values.SelectMany(v => v.Errors)) { <li>@e.ErrorMessage</li> }</ul></div> }
<form method="post" class="card">
    <input type="hidden" name="Type" value="@Model.Type" />
    <div class="filters">
        <div><label>Titre (facultatif)</label><input asp-for="Params.Title" maxlength="250" /></div>
        @if (needsPeriod)
        {
            <div><label>Du *</label><input asp-for="Params.From" type="date" required /></div><div><label>Au *</label><input asp-for="Params.To" type="date" required /></div>
            <div><label>Campagne</label><select asp-for="Params.CampaignId" asp-items="Model.Campaigns"></select></div>
            <div><label>Secteur</label><select asp-for="Params.CategoryId" asp-items="Model.Categories"></select></div>
            @if (Model.Type == ReportType.Individual) { <div><label>Commercial</label><select asp-for="Params.UserId" asp-items="Model.Users"></select></div> }
        }
        @if (Model.Type == ReportType.OutingBalance) { <div><label>Sortie *</label><select asp-for="Params.OutingId" asp-items="Model.Outings"></select></div> }
        @if (Model.Type == ReportType.MarketStudy)
        {
            <div><label>Recherche</label><input asp-for="Filter.Search" /></div>
            <div data-geo-chain style="display:contents">
                <div><label>Wilaya</label><select data-geo asp-for="Filter.WilayaId" asp-items="Model.Wilayas"></select></div>
                <div><label>Daïra</label><select data-geo data-placeholder="Toutes" asp-for="Filter.DairaId" asp-items="Model.Dairas"></select></div>
                <div><label>Commune</label><select data-geo data-placeholder="Toutes" asp-for="Filter.CommuneId" asp-items="Model.Communes"></select></div>
            </div>
            <div><label>Activité</label><select asp-for="Filter.CategoryId" asp-items="Model.Categories"></select></div>
        }
    </div>
    @if (Model.Type == ReportType.MarketStudy) { <p><label>Objectif et périmètre de l'étude</label><textarea asp-for="Params.Objective"></textarea></p> }
    @if (Model.Type == ReportType.OutingBalance)
    {
        <p><label>Retours positifs</label><textarea asp-for="Params.PositiveFeedback"></textarea></p>
        <p><label>Difficultés rencontrées</label><textarea asp-for="Params.Difficulties"></textarea></p>
        <p><label>Améliorations proposées</label><textarea asp-for="Params.Improvements"></textarea></p>
    }
    <p><label><input type="checkbox" asp-for="Share" /> Partager ce rapport avec ma hiérarchie (responsable / administrateur) — privé par défaut</label></p>
    <div class="actions"><button type="submit" asp-page-handler="Preview" class="secondary">Prévisualiser</button><button type="submit" asp-page-handler="Save" data-confirm="Enregistrer ce rapport ? Ses chiffres seront figés.">Enregistrer le rapport</button></div>
</form>
@if (Model.Preview is not null) { <div class="alert warn">Aperçu non enregistré. Modifiez les paramètres puis enregistrez.</div><partial name="_ReportDoc" model="Model.Preview" /> }
