@page
@model Prospecta.Web.Pages.Collection.IndexModel
@{ ViewData["Title"] = "Recherche et collecte"; }
<h1>Recherche et collecte</h1>
<div class="alert warn" role="note">Source utilisée : <b>OpenStreetMap</b> (gratuit, sans clé, © contributeurs OpenStreetMap — ODbL). La couverture est partielle en Algérie : toutes les fiches importées sont « à vérifier ». Pour les autres sources, utilisez le <a href="/Imports/Template?format=xlsx">modèle Excel</a>.</div>
@if (!ModelState.IsValid) { <div class="alert err" role="alert"><ul>@foreach (var e in ModelState.Values.SelectMany(v => v.Errors)) { <li>@e.ErrorMessage</li> }</ul></div> }
<form method="post" class="card"><div class="filters">
    <div data-geo-chain style="display:contents">
        <div><label for="WilayaId">Wilaya *</label><select data-geo asp-for="WilayaId" asp-items="Model.Wilayas"></select></div>
        <div><label for="DairaId">Daïra</label><select data-geo data-placeholder="—" asp-for="DairaId" asp-items="Model.Dairas"></select></div>
        <div><label for="Request2_AreaId">Commune</label><select data-geo data-placeholder="Toute la daïra" asp-for="Request2.AreaId" asp-items="Model.Communes"></select></div>
    </div>
    <div><label for="Request2_CategoryId">Activité *</label><select data-category-root="sub" asp-for="Request2.CategoryId" asp-items="Model.Categories"></select></div>
    <div><label for="sub">Sous-activité</label><select id="sub" asp-for="SubCategoryId" data-placeholder="—"><option value="">—</option></select></div>
    <div><label for="Request2_Keywords">Mots-clés dans le nom (séparés par des virgules)</label><input asp-for="Request2.Keywords" maxlength="100" /></div>
    <div><label for="Request2_MaxResults">Résultats max (≤ 200)</label><input asp-for="Request2.MaxResults" type="number" min="1" max="200" /></div>
    <div><label for="Request2_Bbox">Boîte géographique (facultatif) « sud,ouest,nord,est »</label><input asp-for="Request2.Bbox" placeholder="36.70,3.25,36.76,3.34" /></div>
</div>
<p class="muted">Étendre la recherche à d'autres communes : relancez avec une autre commune ou une daïra entière (recherche par ses communes). Les entreprises déjà importées sont reconnues, jamais dupliquées.</p>
<div class="actions"><button type="submit">Lancer la recherche</button><a class="btn secondary" href="/Sources">Sources de données</a></div></form>
<h2>Journal des collectes</h2>
@if (Model.Jobs.Items.Count == 0) { <div class="card">Aucune collecte pour le moment.</div> }
else
{
    <div class="tablewrap"><table class="responsive"><thead><tr><th>Date</th><th>Par</th><th>Zone</th><th>État</th><th>Trouvées</th><th>Nouvelles</th><th>Doublons</th><th>Importées</th><th>Message</th></tr></thead><tbody>
    @foreach (var j in Model.Jobs.Items)
    {
        <tr><td data-label="Date"><a href="/Collection/Job/@j.Id">@AppPage.Local(j.StartedAt)</a></td><td data-label="Par">@j.User</td><td data-label="Zone">@j.Summary</td><td data-label="État"><span class="badge @(j.Status == CollectionJobStatus.Completed ? "ok" : "bad")">@j.Status</span></td>
            <td data-label="Trouvées">@j.Found</td><td data-label="Nouvelles">@j.NewCount</td><td data-label="Doublons">@j.DuplicateCount</td><td data-label="Importées">@j.ImportedCount</td><td data-label="Message">@j.Message</td></tr>
    }</tbody></table></div>
    <partial name="_Pager" model="(Model.Jobs.Page, Model.Jobs.TotalPages, Model.Jobs.Total)" />
}
