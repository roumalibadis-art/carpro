@page
@model Prospecta.Web.Pages.Admin.GeographyModel
@{ ViewData["Title"] = "Géographie"; var levelName = Model.ListLevel switch { GeoLevel.Wilaya => "wilaya", GeoLevel.Daira => "daïra", GeoLevel.Commune => "commune", _ => "quartier" }; }
<h1>Référentiel géographique</h1>
<nav class="muted">@for (var i = 0; i < Model.Crumbs.Count; i++) { if (i > 0) { <span> › </span> } <a href="@Model.Crumbs[i].Url">@Model.Crumbs[i].Label</a> }</nav>
<h2>@(char.ToUpper(levelName[0]) + levelName[1..])s</h2>
<div class="tablewrap"><table class="responsive"><thead><tr><th>Code</th><th>Nom</th><th>Actif</th><th></th></tr></thead><tbody>
@foreach (var g in Model.Items)
{
    <tr>
        <td data-label="Code"><form id="gf-@g.Id" method="post" asp-page-handler="Save"><input type="hidden" name="id" value="@g.Id" /></form><input form="gf-@g.Id" name="code" value="@g.Code" maxlength="20" size="6" aria-label="Code de @g.Name" /></td>
        <td data-label="Nom"><input form="gf-@g.Id" name="name" value="@g.Name" maxlength="150" required aria-label="Nom de @g.Name" /></td>
        <td data-label="Actif"><input form="gf-@g.Id" type="checkbox" name="active" value="true" checked="@g.IsActive" aria-label="@g.Name actif" /></td>
        <td><button form="gf-@g.Id" type="submit" class="secondary">Enregistrer</button> @if (Model.ListLevel != GeoLevel.Quartier) { <a href="@Model.Child(g.Id)">Ouvrir ›</a> }</td></tr>
}
</tbody></table></div>
@if (Model.Items.Count == 0) { <p class="muted">Aucun élément à ce niveau.</p> }
<form method="post" asp-page-handler="Save" class="card row" style="align-items:end">
    <div><label for="name">Nouvelle @levelName — nom</label><input id="name" name="name" required maxlength="150" /></div><div><label for="code">Code (facultatif)</label><input id="code" name="code" maxlength="20" size="6" /></div><button type="submit">Ajouter</button>
</form>
<form method="post" asp-page-handler="Import" enctype="multipart/form-data" class="card">
    <h2>Importer des daïras / communes / quartiers (CSV)</h2>
    <p class="muted">Colonnes : <code>wilaya;daira;commune</code> et, en option, <code>quartier</code>. La wilaya s'indique par son nom ou son code à 2 chiffres et doit déjà exister. Réimporter le même fichier ne crée aucun doublon. Utilisez la liste officielle de votre source (ONS / ANIREF). <a href="/Admin/Geography?handler=Template">Télécharger le modèle CSV</a>.</p>
    <div class="row" style="align-items:end"><input type="file" name="file" accept=".csv" required aria-label="Fichier CSV de géographie" /><button type="submit">Importer</button></div>
</form>
