@page
@model Prospecta.Web.Pages.Refresh.IndexModel
@{ ViewData["Title"] = "Actualisation et vérification"; }
<h1>Actualisation et vérification des fiches</h1>
<p class="muted">Sélectionnez les fiches à revérifier (non vérifiées depuis X mois, téléphone manquant, erreur de contact, changement signalé), puis comparez-les au site web public de l'entreprise. Les écarts sont <b>proposés</b> : une valeur confirmée par une personne n'est jamais écrasée.</p>
<form method="get" class="card row" style="align-items:end">
    <div><label>Non vérifiées depuis (mois)</label><input asp-for="Months" type="number" min="0" max="60" /></div>
    <label><input type="checkbox" asp-for="MissingPhone" /> téléphone manquant</label><label><input type="checkbox" asp-for="ContactError" /> erreur de contact</label><label><input type="checkbox" asp-for="ChangeReported" /> changement signalé</label>
    <button type="submit">Sélectionner</button></form>
@if (Model.Result.Items.Count == 0) { <div class="card">@Strings.T("common.empty") Seules les fiches avec un site web peuvent être comparées automatiquement ; les autres se revérifient par téléphone ou sur place.</div> }
else
{
    <div class="tablewrap"><table class="responsive"><thead><tr><th>Entreprise</th><th>Commune</th><th>Site</th><th>Dernière vérification</th><th></th></tr></thead><tbody>
    @foreach (var b in Model.Result.Items)
    {
        <tr><td data-label="Entreprise"><a href="/Businesses/Details/@b.Id">@b.Name</a></td><td data-label="Commune">@(b.Commune ?? "—")</td><td data-label="Site">@b.Website</td><td data-label="Vérification">@(b.LastVerifiedAt?.ToString("dd/MM/yyyy") ?? "jamais")</td><td><a class="btn secondary" href="/Refresh/Check/@b.Id">Comparer au site</a></td></tr>
    }</tbody></table></div>
    <partial name="_Pager" model="(Model.Result.Page, Model.Result.TotalPages, Model.Result.Total)" />
}
